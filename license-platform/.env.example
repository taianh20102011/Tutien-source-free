# Use a long random value (at least 24 characters) in production.
TUTIEN_ADMIN_TOKEN=replace-with-a-long-random-admin-token
HOST=127.0.0.1
PORT=8787
# Set TRUST_PROXY=true ONLY behind a reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
# Optional persistent data path:
# TUTIEN_DATA_DIR=/var/lib/tutien-license
